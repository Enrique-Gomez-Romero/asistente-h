# Gemini central para toda la plataforma (sin esta llave se usa el simulador seguro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Meta WhatsApp Business Platform
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
META_APP_SECRET=
META_APP_ID=
META_CONFIG_ID=

# Protege el endpoint que ejecuta recordatorios programados
AUTOMATION_SECRET=

# Google Calendar OAuth (opcional; la exportación .ics funciona sin estas llaves)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública donde Meta enviará los webhooks
PUBLIC_APP_URL=https://tu-dominio.example

# Administradores iniciales de la plataforma (separados por coma)
PLATFORM_ADMIN_EMAILS=admin@tu-dominio.com

# Invitaciones por correo
RESEND_API_KEY=
EMAIL_FROM=Asistente H <acceso@tu-dominio.com>

# Google Secret Manager para credenciales individuales de Meta
GOOGLE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
