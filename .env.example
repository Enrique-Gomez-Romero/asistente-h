# OpenAI (opcional: sin esta llave se usa el simulador local seguro)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Meta WhatsApp Business Platform
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
META_APP_SECRET=
META_APP_ID=
META_CONFIG_ID=

# Protege el endpoint que ejecuta recordatorios programados
AUTOMATION_SECRET=

# Google Calendar OAuth (opcional; la exportación .ics funciona sin estas llaves)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública donde Meta enviará los webhooks
PUBLIC_APP_URL=https://tu-dominio.example
