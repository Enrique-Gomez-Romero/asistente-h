# Gemini central para toda la plataforma (sin esta llave se usa el simulador seguro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Meta WhatsApp Business Platform (configuración compartida de Asistente H)
# Respaldo opcional solo para una prueba de un único negocio. Las credenciales
# de clientes reales se guardan por organización mediante Embedded Signup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
META_APP_SECRET=
META_APP_ID=
META_CONFIG_ID=

# Nombres exactos de plantillas aprobadas en WhatsApp Manager
WHATSAPP_TEMPLATE_REMINDER_24H=
WHATSAPP_TEMPLATE_REMINDER_2H=
WHATSAPP_TEMPLATE_FOLLOW_UP=
WHATSAPP_TEMPLATE_SURVEY=
WHATSAPP_TEMPLATE_REACTIVATION=
WHATSAPP_TEMPLATE_LANGUAGE=es_MX

# Protege el endpoint que ejecuta recordatorios programados
AUTOMATION_SECRET=

# Google Calendar OAuth (opcional; la exportación .ics funciona sin estas llaves)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cadena aleatoria larga (mínimo recomendado: 32 bytes)
GOOGLE_OAUTH_STATE_SECRET=

# URL pública donde Meta enviará los webhooks
PUBLIC_APP_URL=https://tu-dominio.example

# Administradores iniciales de la plataforma (separados por coma)
PLATFORM_ADMIN_EMAILS=admin@tu-dominio.com

# Enlace de un solo uso para crear la primera cuenta administrativa
# Usa una cadena aleatoria de al menos 32 caracteres y guárdala como secreto.
AUTH_SETUP_TOKEN=

# Contacto mostrado en privacidad y solicitudes ARCO
PRIVACY_CONTACT_EMAIL=privacidad@tu-dominio.com

# Invitaciones por correo
RESEND_API_KEY=
EMAIL_FROM=Asistente H <acceso@tu-dominio.com>

# Google Secret Manager para credenciales individuales de Meta
GOOGLE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
